{
  "manifest_version": 3,
  "name": "Kinopoisk Subtitle Overlay",
  "description": "Load custom SRT subtitles on Kinopoisk HD",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://hd.kinopoisk.ru/*", "https://www.kinopoisk.ru/*"],
  "content_scripts": [
    {
      "matches": ["https://hd.kinopoisk.ru/*", "https://www.kinopoisk.ru/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
